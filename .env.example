# ---- App ----
APP_NAME=rentos
APP_ENV=development        # development | production
APP_PORT=8080
APP_SECRET=change-me-32-chars-minimum

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=rentos
DB_PASSWORD=rentos
DB_NAME=rentos_db
DB_POOL_MAX_OPEN=25
DB_POOL_MAX_IDLE=5
DB_POOL_TIMEOUT_SECONDS=30

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=change-me-64-chars-minimum
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=30

# ---- Workers ----
WORKER_MAINTENANCE_INTERVAL_MINUTES=5
WORKER_REPORT_INTERVAL_SECONDS=30
WORKER_WEBHOOK_INTERVAL_SECONDS=10
WORKER_NOTIFICATION_INTERVAL_SECONDS=15

# ---- Storage (report file output) ----
STORAGE_BASE_PATH=/var/rentos/storage
STORAGE_REPORTS_PATH=/var/rentos/storage/reports

# ---- Email (plug in provider) ----
EMAIL_FROM=noreply@rentos.app
EMAIL_PROVIDER=smtp          # smtp | ses | sendgrid
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ---- WhatsApp / SMS (stub — plug in provider) ----
WHATSAPP_PROVIDER=zenziva    # zenziva | twilio
WHATSAPP_API_KEY=
SMS_PROVIDER=zenziva
SMS_API_KEY=
